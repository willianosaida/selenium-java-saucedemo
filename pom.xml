<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.willian</groupId>
    <artifactId>selenium-java-saucedemo</artifactId>
    <version>1.0.0</version>
    <name>Selenium Java - SauceDemo</name>
    <description>Projeto de automação de testes Web com Java, Selenium e JUnit.</description>

    <!-- Centraliza versões e opções usadas pelo Maven para preparar o projeto. -->
    <properties>
        <!-- O código é compilado para Java 17; o pipeline usa um JDK 25 para executar o Maven. -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <selenium.version>4.49.0</selenium.version>
        <junit.version>6.1.2</junit.version>
        <surefire.version>3.5.4</surefire.version>
    </properties>

    <!-- O BOM mantém as versões dos componentes do JUnit alinhadas entre si. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Dependências são bibliotecas externas utilizadas pelo nosso código. -->
    <dependencies>
        <!-- Selenium fornece os comandos para controlar o navegador. -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <!-- JUnit identifica os testes e oferece as verificações (assertions). -->
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <!-- Compila os arquivos Java antes da execução. -->
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <!-- Executa os testes na fase test e grava seus resultados em target. -->
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <argLine>-Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <!-- Transforma os resultados dos testes em um relatório HTML para leitura. -->
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <outputDirectory>${project.build.directory}/reports</outputDirectory>
                    <outputName>relatorio-testes</outputName>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
